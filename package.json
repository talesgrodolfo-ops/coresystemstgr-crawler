{
  "name": "coresystemstgr-crawler",
  "private": true,
  "version": "1.0.0",
  "description": "Crawler + API + Dashboard com integração N8N",
  "scripts": {
    "dev": "concurrently -n api,dashboard -c blue,green \"pnpm --filter @core/api dev\" \"pnpm --filter @core/dashboard dev\"",
    "dev:api": "pnpm --filter @core/api dev",
    "dev:dashboard": "pnpm --filter @core/dashboard dev",
    "crawl": "pnpm --filter @core/crawler start",
    "build": "pnpm -r build",
    "start:api": "pnpm --filter @core/api start",
    "deploy:api": "pnpm --filter @core/api deploy",
    "deploy:dashboard": "pnpm --filter @core/dashboard build && pnpm --filter @core/dashboard deploy",
    "db:migrate": "pnpm --filter @core/api db:migrate:remote",
    "cf:login": "pnpm --filter @core/api exec wrangler login",
    "cf:d1:create": "pnpm --filter @core/api exec wrangler d1 create crawler-hub"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
